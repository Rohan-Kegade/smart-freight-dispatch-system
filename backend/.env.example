# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:   postgresql://postgres:<password>@localhost:5432/freight_dispatch
# Production:  pulled from AWS Secrets Manager via ECS task definition
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/freight_dispatch

# ── External APIs ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_SNS_TOPIC_ARN=arn:aws:sns:<region>:<account-id>:<topic-name>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_characters

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

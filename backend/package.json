{
  "name": "freight-dispatch-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "migrate:down": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate down",
    "seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.438.0",
    "@aws-sdk/client-sns": "^3.438.0",
    "@googlemaps/google-maps-services-js": "^3.3.41",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^6.2.2",
    "openai": "^4.20.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
